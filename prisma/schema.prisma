generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int    @id @default(autoincrement())
  name        String @unique
  permissions Json   @default("[]")
  users       User[]
}

model Department {
  id              Int       @id @default(autoincrement())
  name            String    @unique
  schedulePola    String    @default("POLA_1") // POLA_1 … POLA_6 (absen OR-Tools engine)
  scheduleEnabled Boolean   @default(true) // false = skip generate roster / auto-absen
  locations       Location[]
  users           User[]
  tickets         Ticket[]
  actionItems     ActionItem[]
  queues          TicketQueue[]
}

model Location {
  id           Int        @id @default(autoincrement())
  city         String
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  users        User[]
}

model User {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  name         String?
  avatarUrl    String?
  signature    String?
  password     String      @default("password123")
  roleId       Int
  role         Role        @relation(fields: [roleId], references: [id])
  departmentId Int
  department   Department  @relation(fields: [departmentId], references: [id])
  locationId   Int?
  location     Location?   @relation(fields: [locationId], references: [id])
  skillTags    String      @default("[]")
  scheduleFlag String      @default("Umum") // Umum | Kristen | Kuliah — bias untuk generator pola
  tickets      Ticket[]    @relation("AssignedUser")
  reports      DailyReport[]
  comments     Comment[]
  historyLogs  TicketHistory[]
  attachments  Attachment[]
  meetingsOrganized Meeting[] @relation("MeetingOrganizer")
  meetingsAttending Meeting[] @relation("MeetingAttendees")
  presentSessions   MeetingSession[] @relation("SessionPresentAttendees")
  meetingSessions   MeetingSession[]
  actionItems       ActionItem[]
  schedulePreference UserSchedulePreference?
  schedules         ShiftSchedule[]
  articles          KnowledgeArticle[]
  ticketNotes       TicketNote[]
  watchedTickets    TicketWatcher[]
}

model Ticket {
  id           Int        @id @default(autoincrement())
  trackingId   String?    @unique @default(uuid())
  title        String
  description  String
  status       String     @default("New")
  ticketType   String     @default("Incident") // Incident | Problem | Change | Request
  customData   Json?
  priority     String     @default("Medium")
  
  // SLA Tracking (Phase 22 + P0 policy)
  nextSlaDeadline DateTime?
  slaBreaches     Int       @default(0)
  slaTimerMins    Int       @default(15)
  enableSla       Boolean   @default(false)
  responseDueAt   DateTime?
  resolutionDueAt DateTime?
  firstRespondedAt DateTime?
  
  escalationLevel Int       @default(0)
  approvalStatus  String?   // null | Pending | Approved | Rejected
  csatScore       Int?
  csatComment     String?
  csatAt          DateTime?

  // Integration API
  externalRef      String?
  idempotencyKey   String?
  integrationAppId Int?
  integrationApp   IntegrationApp? @relation(fields: [integrationAppId], references: [id])

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  queueId       Int?
  queue         TicketQueue? @relation(fields: [queueId], references: [id])
  assigneeId   Int?
  assignee     User?      @relation("AssignedUser", fields: [assigneeId], references: [id])
  jobCategoryId Int?
  jobCategory  JobCategory? @relation(fields: [jobCategoryId], references: [id])
  awardedScore Int?
  comments     Comment[]
  historyLogs  TicketHistory[]
  attachments  Attachment[]
  meetings     Meeting[]
  actionItem   ActionItem?
  notes        TicketNote[]
  watchers     TicketWatcher[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  resolvedAt   DateTime?
  services     Service[]

  @@unique([integrationAppId, idempotencyKey])
  @@index([externalRef])
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  isPublic  Boolean  @default(true)
  attachments Attachment[]
  createdAt DateTime @default(now())
}

model DailyReport {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Meeting {
  id            Int      @id @default(autoincrement())
  title         String
  agenda        String?
  problems      String?
  solutions     String?
  status        String   @default("Scheduled")
  scheduledAt   DateTime
  organizedById Int?
  organizedBy   User?    @relation("MeetingOrganizer", fields: [organizedById], references: [id])
  attendees     User[]   @relation("MeetingAttendees")
  sessions      MeetingSession[]
  actionItems   ActionItem[]
  discussedTickets Ticket[]
  createdAt     DateTime @default(now())
}

model CustomField {
  id       Int     @id @default(autoincrement())
  name     String
  type     String  @default("text") 
  options  String? 
  required Boolean @default(false)
  active   Boolean @default(true)
  position String  @default("bottom")
}

model TicketHistory {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  action    String   
  actorId   Int?     
  actor     User?    @relation(fields: [actorId], references: [id])
  
  // Segmented Timeline Point Ledger
  jobCategoryId Int?
  awardedScore  Int?
  
  createdAt DateTime @default(now())
}

model Attachment {
  id         Int      @id @default(autoincrement())
  filename   String
  url        String
  ticketId   Int?
  ticket     Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId  Int?
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy Int
  uploader   User     @relation(fields: [uploadedBy], references: [id])
  createdAt  DateTime @default(now())
}

model JobCategory {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  score    Int      @default(0)
  active   Boolean  @default(true)
  tickets  Ticket[]
}

model ActionItem {
  id           Int      @id @default(autoincrement())
  task         String
  status       String   @default("Pending") 
  meetingId    Int
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingSessionId Int?
  meetingSession   MeetingSession? @relation(fields: [meetingSessionId], references: [id], onDelete: Cascade)
  assigneeId   Int?
  assignee     User?    @relation(fields: [assigneeId], references: [id])
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  linkedTicketId Int?      @unique
  linkedTicket   Ticket?   @relation(fields: [linkedTicketId], references: [id])
  dueDate      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MeetingSession {
  id        Int      @id @default(autoincrement())
  meetingId Int
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title     String?
  scheduledFor DateTime?
  content   String?  @db.Text
  authorId  Int      
  author    User     @relation(fields: [authorId], references: [id])
  presentAttendees User[] @relation("SessionPresentAttendees")
  actionItems ActionItem[]
  createdAt DateTime @default(now())
}

model ShiftType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  startTime String 
  endTime   String 
  preferences UserSchedulePreference[]
  schedules   ShiftSchedule[]
  generatedSchedules ShiftSchedule[] @relation("GeneratedShiftBaseline")
  active    Boolean  @default(true)
}

model UserSchedulePreference {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleMode   String    @default("RANDOM") 
  fixedShiftId   Int?
  fixedShift     ShiftType? @relation(fields: [fixedShiftId], references: [id])
  fixedOffDays   String    @default("[]") 
}

model ShiftSchedule {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime  @db.Date
  shiftTypeId    Int?
  shiftType      ShiftType? @relation(fields: [shiftTypeId], references: [id])
  generatedShiftTypeId Int?
  generatedShiftType   ShiftType? @relation("GeneratedShiftBaseline", fields: [generatedShiftTypeId], references: [id])
  isLembur             Boolean   @default(false)
  highlightColor String?   // e.g. #fef08a — manager/staff marker (stabilo)
  note           String?   @db.Text
  noteUpdatedBy  Int?
  noteUpdatedAt  DateTime?

  @@unique([userId, date])
}

// ==========================================
// Phase 32: Knowledge Base
// ==========================================

model KnowledgeCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  icon        String?
  articles    KnowledgeArticle[]
}

model KnowledgeArticle {
  id          Int      @id @default(autoincrement())
  title       String
  content     String   @db.Text
  categoryId  Int
  category    KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// Phase 33: Telecom Asset Management
// ==========================================

model Customer {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  contactEmail String?
  contactPhone String?
  services     Service[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ServiceTemplate {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  fields      Json      @default("[]") // Defines dynamic schema fields
  active      Boolean   @default(true)
  services    Service[]
}

model Service {
  id           Int        @id @default(autoincrement())
  customerId   Int
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  templateId   Int
  template     ServiceTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  name         String
  status       String     @default("Active")
  customData   Json?      // Stores actual field values mapped to Template
  monthlyCost  Decimal?
  currency     String     @default("IDR")
  contractEnd  DateTime?
  hops         CircuitHop[]
  tickets      Ticket[]   // M:N Relation with Tickets
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CircuitHop {
  id          Int      @id @default(autoincrement())
  serviceId   Int
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  orderIndex  Int      @default(0)
  location    String
  deviceName  String
  portName    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// Phase 34: Ticket Notes (CS Internal Tracking)
// ==========================================

model TicketNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  content   String   @db.Text
  noteType  String   @default("internal") // "internal", "follow_up", "escalation", "customer_update"
  createdAt DateTime @default(now())
}

// ==========================================
// Phase 35: System Configuration
// ==========================================

model AppSetting {
  key   String @id
  value String @db.Text
}

// ==========================================
// P0–P3: Ticketing power features
// ==========================================

model TicketQueue {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  skillTags    String      @default("[]")
  active       Boolean     @default(true)
  tickets      Ticket[]
  createdAt    DateTime    @default(now())
}

model TicketWatcher {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ticketId, userId])
}

model EscalationRule {
  id                 Int      @id @default(autoincrement())
  name               String
  fromLevel          Int      @default(0)
  toLevel            Int
  afterBreachCount   Int      @default(1)
  targetRole         String?
  targetDepartmentId Int?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model NotificationLog {
  id        Int      @id @default(autoincrement())
  ticketId  Int?
  channel   String   @default("log")
  event     String
  recipient String   @default("")
  status    String   @default("sent")
  payload   Json?
  createdAt DateTime @default(now())
}

// ==========================================
// Integration Platform v1
// ==========================================

model IntegrationApp {
  id                   Int      @id @default(autoincrement())
  name                 String   @unique
  description          String?
  keyPrefix            String   // first 8 chars for display
  keyHash              String   @unique
  scopes               String   @default("[\"tickets:create\",\"tickets:read\"]")
  webhookUrl           String?
  webhookSecret        String?
  webhookEvents        String   @default("[\"ticket.created\",\"ticket.status_changed\",\"ticket.resolved\"]")
  defaultDepartmentId  Int?
  rateLimitPerMinute   Int      @default(60)
  active               Boolean  @default(true)
  tickets              Ticket[]
  auditLogs            IntegrationAuditLog[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model IntegrationAuditLog {
  id               Int             @id @default(autoincrement())
  integrationAppId Int?
  integrationApp   IntegrationApp? @relation(fields: [integrationAppId], references: [id], onDelete: SetNull)
  method           String
  path             String
  statusCode       Int
  ip               String?
  externalRef      String?
  ticketId         Int?
  message          String?
  createdAt        DateTime        @default(now())

  @@index([integrationAppId, createdAt])
}
